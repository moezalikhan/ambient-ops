# Secrets
.env
.env.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
frontend/.vite/
# frontend/dist IS tracked: the deployed container serves it, and a fresh
# clone then runs without needing npm. Rebuild and commit it after any
# frontend change — `npm run build` in frontend/.

# Caches and generated data
*.db
*.sqlite3
# ...except the pre-cached demo data. 564 KB, and without it a fresh clone or
# a deploy starts cold: every route would trigger a live satellite pass,
# roughly 20 minutes and 250,000 credits each. Committing it is what makes
# "clone and run" actually work.
!data/ambient_ops.db
data/cached_grids/*
!data/cached_grids/.gitkeep

# OS / editor
.DS_Store
.idea/
.vscode/

# Local Claude Code permissions (machine-specific)
.claude/settings.local.json
