# Copy to .env and fill in. .env is gitignored — never commit real keys.

# FortyGuard Temperature API (primary heat data source)
FORTYGUARD_API_KEY=
FORTYGUARD_BASE_URL=https://api.fortyguard.com/v1

# Which analysis layer drives the Heat Exposure Index.
#   exceedance      hours the temperature passes the threshold   <- default
#   persistence     longest continuous run of hours past it
#   tcm             single temperature snapshot (weather, not risk)
#   time_of_measure hour of day each tile peaks
# Confirm with: python scripts/verify_fortyguard.py
FORTYGUARD_ANALYTIC_TYPE=exceedance

# Threshold in °C for exceedance/persistence, and which side of it to count.
# Minqi owns the final value and it needs a citation.
HEAT_THRESHOLD_C=35
HEAT_DIRECTION=above

# Days in the exceedance window (API max 1 month). Short windows flatten HEI.
HEAT_WINDOW_DAYS=30

# Tile size in metres. The API accepts 60, 80, or 100.
FORTYGUARD_GRANULARITY_M=60

# Metres buffered either side of the route when building the AOI polygon.
ROUTE_BUFFER_M=120

# OpenRouteService — free walking directions (openrouteservice.org)
# Leave blank to fall back to the public OSRM demo server (car-biased).
ORS_API_KEY=

# Anthropic — powers the agent tool-calling loop (console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Overpass API (OpenStreetMap context). Public instance; no key required.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Local paths
CACHE_DB_PATH=data/ambient_ops.db
