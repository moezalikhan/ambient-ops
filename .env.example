# Copy to .env and fill in. .env is gitignored — never commit real keys.

# FortyGuard Temperature API (primary heat data source)
FORTYGUARD_API_KEY=
FORTYGUARD_BASE_URL=https://api.fortyguard.com

# OpenRouteService — free walking directions (openrouteservice.org)
# Leave blank to fall back to the public OSRM demo server (car-biased).
ORS_API_KEY=

# Anthropic — powers the agent tool-calling loop (console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Overpass API (OpenStreetMap context). Public instance; no key required.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Local paths
CACHE_DB_PATH=data/ambient_ops.db
